# HepaTwin Backend – Environment variables
# Copy this file to .env and fill in your values.

# ── JWT Auth ─────────────────────────────────────────────────────────────────
# Generate a long random secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_strong_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite is used by default (no extra setup needed).
# To switch to Postgres set e.g.: postgresql+asyncpg://user:pass@localhost/hepatwin
DATABASE_URL=sqlite+aiosqlite:///./hepatwin.db

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma‑separated list of allowed origins for the React dev server.
CORS_ORIGINS=http://localhost:5175,http://localhost:5176,http://localhost:3000

# ── Kalman filter defaults ────────────────────────────────────────────────────
# These can be overridden per‑request but these are the application‑level defaults.
KALMAN_OBS_STD=0.2
KALMAN_PROCESS_STD=0.1
KALMAN_INIT_LEVEL_STD=1.0
KALMAN_INIT_SLOPE_STD=0.5

# ── Optional: external LLM / AI API key (not required for core pipeline) ──────
# Used only if you enable the /ai/explain endpoint.
OPENAI_API_KEY=
